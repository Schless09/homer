# ── AI (server-side only; never exposed to the browser) ──────────────────────
# Without a key the app runs the built-in rule-based designer ("Demo mode").
ANTHROPIC_API_KEY=

# Cost-first defaults: every user-facing AI call uses Claude Haiku 5.5.
# Escalate individual tasks only if quality needs it:
# ANTHROPIC_MODEL=claude-haiku-5-5            # base for all tasks
# ANTHROPIC_DESIGNER_MODEL=claude-haiku-5-5   # AI interior designer chat + tool use
# ANTHROPIC_DESIGNER_EFFORT=medium            # low | medium | high
# ANTHROPIC_VISION_MODEL=claude-haiku-5-5     # floor plan reading (try claude-sonnet-5-5 for messy scans)
# ANTHROPIC_VISION_EFFORT=medium

# ── Photorealistic renders (optional) ────────────────────────────────────────
# Gemini image model: renders from the 3D snapshot AND real product photos.
# Use a Homer-specific key (not another app's GEMINI_API_KEY).
# HOMER_GEMINI_API_KEY=
# HOMER_GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Fallback provider (snapshot + text only):
# REPLICATE_API_TOKEN=
# REPLICATE_RENDER_MODEL=black-forest-labs/flux-kontext-pro

# ── Persistence (optional) ───────────────────────────────────────────────────
# Without these, projects are saved in the browser (IndexedDB).
# Apply supabase/migrations first and enable Anonymous sign-ins in Supabase Auth.
# Homer only reads these HOMER_ names (generic NEXT_PUBLIC_SUPABASE_* are ignored).
# HOMER_NEXT_PUBLIC_SUPABASE_URL=
# HOMER_NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Retailer product feeds & affiliate commissions (optional) ────────────────
# Feeds to sync daily (Vercel Cron -> /api/feeds/sync). Feed URLs usually embed
# credentials, so keep this in env, not in code. Networks: impact, cj, rakuten,
# awin, shareasale, amazon, direct.
# HOMER_FEEDS=[{"retailer":"Article","network":"impact","url":"https://..."}]
# Secret key for the Homer Supabase project, used ONLY by the server-side feed
# sync to write products. Never prefix with NEXT_PUBLIC_.
# HOMER_SUPABASE_SECRET_KEY=
# Vercel sends this as a Bearer token to cron routes.
# CRON_SECRET=
# Amazon Associates tag, if you add Amazon products.
# HOMER_AMAZON_ASSOCIATE_TAG=

# Public contact email shown on About/Privacy pages (affiliate networks require one).
# NEXT_PUBLIC_HOMER_CONTACT_EMAIL=
