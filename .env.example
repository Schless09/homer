# ── AI (server-side only; never exposed to the browser) ──────────────────────
# Without a key the app runs the built-in rule-based designer ("Demo mode").
ANTHROPIC_API_KEY=

# Cost-first defaults: every user-facing AI call uses Claude Haiku 5.5.
# Escalate individual tasks only if quality needs it:
# ANTHROPIC_MODEL=claude-haiku-5-5            # base for all tasks
# ANTHROPIC_DESIGNER_MODEL=claude-haiku-5-5   # AI interior designer chat + tool use
# ANTHROPIC_DESIGNER_EFFORT=medium            # low | medium | high
# ANTHROPIC_VISION_MODEL=claude-haiku-5-5     # floor plan reading (try claude-sonnet-5-5 for messy scans)
# ANTHROPIC_VISION_EFFORT=medium

# ── Photorealistic renders (optional) ────────────────────────────────────────
# REPLICATE_API_TOKEN=
# REPLICATE_RENDER_MODEL=black-forest-labs/flux-kontext-pro

# ── Persistence (optional) ───────────────────────────────────────────────────
# Without these, projects are saved in the browser (IndexedDB).
# Apply supabase/migrations first and enable Anonymous sign-ins in Supabase Auth.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
